+        form.addView(helpCard("±", "Zeleni plus in rdeči minus",
+                "Zeleni + pomeni, da partner dolguje tebi. Rdeči − pomeni, da ti dolguješ partnerju. Stanje je vedno prikazano iz perspektive prijavljenega uporabnika."), dialogMargin());
+        form.addView(helpCard("▥", "Pregledi in kategorije",

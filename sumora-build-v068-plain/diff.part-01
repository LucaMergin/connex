+        AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle("Pomoč in navodila")
+                .setView(scroll)
+                .setPositiveButton("Zapri", null)
+                .create();
+        guide.setOnClickListener(v -> {
+            dialog.dismiss();
+            showOnboarding(false);

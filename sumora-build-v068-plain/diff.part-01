+            renderOnboardingStep(step[0], icons, titles, descriptions, stepLabel, icon, title, description, dots, next);
+            next.setOnClickListener(v -> {
+                if (step[0] >= titles.length - 1) {
+                    dialog.dismiss();
+                    completeOnboarding(firstUse);
+                    return;
+                }
+                step[0]++;
+                renderOnboardingStep(step[0], icons, titles, descriptions, stepLabel, icon, title, description, dots, next);
+            });
+        });
+        dialog.setCanceledOnTouchOutside(false);
+        dialog.show();
+    }
+
+    private void renderOnboardingStep(int step, String[] icons, String[] titles, String[] descriptions,
+                                      TextView stepLabel, TextView icon, TextView title, TextView description,
+                                      LinearLayout dots, Button next) {
+        stepLabel.setText("KORAK " + (step + 1) + " OD " + titles.length);
+        icon.setText(icons[step]);
+        title.setText(titles[step]);
+        description.setText(descriptions[step]);
+        next.setText(step == titles.length - 1 ? "Začni uporabljati" : "Naprej");
+
+        dots.removeAllViews();
+        for (int i = 0; i < titles.length; i++) {
+            View dot = new View(this);
+            dot.setBackground(round(i == step ? BRAND : Color.rgb(209, 213, 219), 6));
+            LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(i == step ? dp(22) : dp(8), dp(8));
+            if (i > 0) p.setMargins(dp(7), 0, 0, 0);
+            dots.addView(dot, p);
+        }
+    }
+
+    private void completeOnboarding(boolean firstUse) {
+        getSharedPreferences(PREFS, MODE_PRIVATE).edit().putBoolean(KEY_ONBOARDING_DONE, true).apply();
+        if (firstUse && !getSharedPreferences(PREFS, MODE_PRIVATE).getBoolean(KEY_SETUP, false)) {
+            new Handler().postDelayed(() -> showSettings(true), 180L);
+        }
+    }
+

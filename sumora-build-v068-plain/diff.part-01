+        form.addView(helpCard("☁", "Sinhronizacija",
+                "Rumeno stanje pomeni, da spremembe čakajo. Rdeče opozori na napako. Pritisni stanje povezave in uporabi »Sinhroniziraj zdaj« ali »Ponovi neuspele prenose«."), dialogMargin());
+        form.addView(helpCard("⇩", "Varnostna kopija",
+                "JSON vsebuje popolno kopijo za obnovitev. CSV je namenjen pregledu v Excelu. Pred obnovitvijo Sumora vedno pokaže, kaj bo dodano ali posodobljeno."), dialogMargin());
+        form.addView(helpCard("↑", "Posodobitve",
+                "Ko je različica na voljo, se pokaže profesionalen seznam novosti. APK se pred namestitvijo preveri s kontrolno vsoto SHA-256."), dialogMargin());
+
+        Button guide = primary("Ponovno zaženi uvodni vodič");
+        LinearLayout.LayoutParams gp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(50));
+        gp.setMargins(0, dp(14), 0, 0);
+        form.addView(guide, gp);
+
+        ScrollView scroll = new ScrollView(this);

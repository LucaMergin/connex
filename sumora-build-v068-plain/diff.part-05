+        new AlertDialog.Builder(this)
+                .setTitle("Kaj naj Sumora naredi z lokalnimi podatki?")
+                .setMessage("Lokalni stroški in poravnave so še vedno na tem telefonu.")
+                .setNegativeButton("Izbriši lokalno", (d, w) -> {

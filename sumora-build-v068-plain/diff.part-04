+                .putLong(KEY_RESTORE_SAFETY_AT, System.currentTimeMillis())
+                .apply();
+    }
+
+    private void confirmUndoRestore() {
+        long time = getSharedPreferences(PREFS, MODE_PRIVATE).getLong(KEY_RESTORE_SAFETY_AT, 0L);
+        if (time == 0L) {
+            toast("Ni shranjene obnovitve za razveljavitev.");
+            return;
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("Razveljavim zadnjo obnovitev?")
+                .setMessage("Povrnjeno bo lokalno stanje pred obnovitvijo z dne " + fullDateTime(time) + ".")
+                .setNegativeButton("Ne", null)
+                .setPositiveButton("Razveljavi", (d, w) -> undoRestore())
+                .show();
+    }
+
+    private void undoRestore() {
+        try {
+            android.content.SharedPreferences p = getSharedPreferences(PREFS, MODE_PRIVATE);
+            expenses = new JSONArray(p.getString(KEY_RESTORE_SAFETY_EXPENSES, "[]"));
+            settlements = new JSONArray(p.getString(KEY_RESTORE_SAFETY_SETTLEMENTS, "[]"));
+            nameA = p.getString(KEY_RESTORE_SAFETY_NAME_A, nameA);
+            nameB = p.getString(KEY_RESTORE_SAFETY_NAME_B, nameB);
+            markCollectionPending(expenses);
+            markCollectionPending(settlements);
+            save();
+            p.edit().remove(KEY_RESTORE_SAFETY_EXPENSES)
+                    .remove(KEY_RESTORE_SAFETY_SETTLEMENTS)
+                    .remove(KEY_RESTORE_SAFETY_NAME_A)
+                    .remove(KEY_RESTORE_SAFETY_NAME_B)
+                    .remove(KEY_RESTORE_SAFETY_AT)
+                    .apply();
+            toast("Prejšnje lokalno stanje je povrnjeno.");
+            showHome();
+            syncWithServer(false);
+        } catch (Exception e) {
+            toast("Razveljavitev ni uspela.");
+        }
+    }
+
+    private void markCollectionPending(JSONArray collection) {
+        for (int i = 0; i < collection.length(); i++) {
+            JSONObject item = collection.optJSONObject(i);
+            if (item == null) continue;
+            try {
+                item.put("syncState", "pending");
+                item.put("syncError", "");
+            } catch (Exception ignored) { }
+        }
+    }
+
+    private String fullDateTime(long time) {
+        return new SimpleDateFormat("dd.MM.yyyy 'ob' HH:mm", new Locale("sl", "SI")).format(new Date(time));
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (resultCode != RESULT_OK || data == null || data.getData() == null) return;
+        Uri uri = data.getData();
+        if (requestCode == REQ_EXPORT_JSON) {
+            try {
+                writeDocument(uri, buildBackupJson().toString(2));
+            } catch (Exception e) {
+                toast("Varnostne kopije ni bilo mogoče pripraviti.");
+            }
+        } else if (requestCode == REQ_EXPORT_CSV_MONTH) {
+            writeDocument(uri, buildCsv(false));
+        } else if (requestCode == REQ_EXPORT_CSV_ALL) {
+            writeDocument(uri, buildCsv(true));
+        } else if (requestCode == REQ_IMPORT_JSON) {
+            inspectRestore(uri);
+        }
+    }
+
+    private void showMembersPanel() {
+        if (supabase == null || !supabase.isReady()) {
+            showCloudPanel();
+            return;
+        }
+        toast("Nalagam člane …");
+        supabase.getHouseholdMembers((ok, message, members) -> {
+            if (!ok) {
+                toast(message);
+                return;
+            }
+            renderMembersPanel(members);
+        });
+    }

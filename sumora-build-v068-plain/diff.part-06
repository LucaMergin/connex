+
+    public void getHouseholdMembers(MembersCallback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                if (!hasHousehold() && !loadMembershipSync()) throw new Exception("Skupni račun še ni povezan.");
+                Response response = request("POST", "/rest/v1/rpc/get_household_members", "{}", true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                JSONArray members = new JSONArray(response.body);
+                deliverMembers(callback, true, "Člani so osveženi.", members);
+            } catch (Exception e) {
+                deliverMembers(callback, false, friendly(e), new JSONArray());
+            }
+        });
+    }
+
+    public void renameHousehold(String name, Callback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                JSONObject body = new JSONObject();
+                body.put("p_name", name == null ? "" : name.trim());
+                Response response = request("POST", "/rest/v1/rpc/rename_my_household", body.toString(), true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                JSONObject result = response.body.trim().isEmpty() ? new JSONObject() : new JSONObject(response.body);
+                String updatedName = result.optString("name", name == null ? "" : name.trim());
+                prefs.edit().putString(KEY_HOUSEHOLD_NAME, updatedName).apply();
+                deliver(callback, true, "Ime skupnega računa je posodobljeno.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }
+
+    public void regenerateInviteCode(Callback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                Response response = request("POST", "/rest/v1/rpc/regenerate_household_invite", "{}", true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                JSONObject result = response.body.trim().isEmpty() ? new JSONObject() : new JSONObject(response.body);
+                String code = result.optString("invite_code", "");
+                if (!code.isEmpty()) prefs.edit().putString(KEY_INVITE, code).apply();
+                deliver(callback, true, "Nova povabilna koda je pripravljena.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }

+-- SUMORA v0.6.8 – upravljanje skupnega računa in članov
+-- Zaženi enkrat v Supabase SQL Editorju pred objavo APK-ja.
+
+create or replace function public.get_household_members()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_household_id uuid;
+  v_result jsonb;
+begin
+  if auth.uid() is null then
+    raise exception 'Prijava je obvezna.';
+  end if;
+
+  select hm.household_id into v_household_id
+  from public.household_members hm
+  where hm.user_id = auth.uid()
+  limit 1;
+
+  if v_household_id is null then
+    raise exception 'Skupni račun še ni povezan.';
+  end if;
+
+  select coalesce(
+    jsonb_agg(
+      jsonb_build_object(
+        'user_id', hm.user_id,
+        'slot', hm.slot,
+        'role', hm.role,
+        'joined_at', hm.joined_at,
+        'display_name', case when hm.slot = 0 then h.person_a_name else h.person_b_name end,
+        'is_me', hm.user_id = auth.uid()
+      )
+      order by hm.slot
+    ),
+    '[]'::jsonb
+  )
+  into v_result
+  from public.household_members hm
+  join public.households h on h.id = hm.household_id
+  where hm.household_id = v_household_id;
+
+  return v_result;
+end;
+$$;
+
+create or replace function public.rename_my_household(p_name text)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_household_id uuid;
+  v_name text;
+begin
+  if auth.uid() is null then
+    raise exception 'Prijava je obvezna.';
+  end if;
+
+  select hm.household_id into v_household_id
+  from public.household_members hm
+  where hm.user_id = auth.uid() and hm.role = 'owner'
+  limit 1;
+
+  if v_household_id is null then
+    raise exception 'Samo lastnik lahko spremeni ime skupnega računa.';
+  end if;
+
+  v_name := coalesce(nullif(trim(p_name), ''), 'Najini stroški');
+  update public.households
+  set name = v_name, updated_at = now()
+  where id = v_household_id;
+
+  return jsonb_build_object('name', v_name);
+end;
+$$;
+

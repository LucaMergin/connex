+                ensureSession();
+                JSONObject body = new JSONObject();
+                body.put("p_user_id", userId);
+                Response response = request("POST", "/rest/v1/rpc/remove_household_member", body.toString(), true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                deliver(callback, true, "Član je odstranjen iz skupnega računa.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }
+
+    public void transferHouseholdOwnership(String userId, Callback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                JSONObject body = new JSONObject();
+                body.put("p_user_id", userId);
+                Response response = request("POST", "/rest/v1/rpc/transfer_household_ownership", body.toString(), true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                loadMembershipSync();
+                deliver(callback, true, "Lastništvo je uspešno preneseno.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }
+
+    public void leaveHousehold(Callback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                Response response = request("POST", "/rest/v1/rpc/leave_my_household", "{}", true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                clearHouseholdLink();
+                deliver(callback, true, "Skupni račun si zapustil/a.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }
+
+    public void deleteHousehold(Callback callback) {
+        runAsync(() -> {
+            try {
+                ensureSession();
+                Response response = request("POST", "/rest/v1/rpc/delete_my_household", "{}", true, null);
+                if (!response.ok()) throw new Exception(errorMessage(response));
+                clearHouseholdLink();
+                deliver(callback, true, "Skupni račun je izbrisan.");
+            } catch (Exception e) {
+                deliver(callback, false, friendly(e));
+            }
+        });
+    }
+
+    private void clearHouseholdLink() {
+        prefs.edit()
+                .remove(KEY_HOUSEHOLD)
+                .remove(KEY_HOUSEHOLD_NAME)
+                .remove(KEY_INVITE)
+                .remove(KEY_SLOT)
+                .remove(KEY_ROLE)
+                .remove(KEY_LAST_SYNC)
+                .remove(KEY_REMOTE_EXPENSES)
+                .remove(KEY_REMOTE_SETTLEMENTS)
+                .apply();
+    }
+
